{
  "compilerOptions": {
    "target": "ES2023",
    "allowJs": true,
    "module": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "monaco-editor/*": ["./node_modules/monaco-editor/*"]
    },
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*", "electron/**/*", "shared/**/*"]
}
